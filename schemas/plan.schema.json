                "export_end": {
                  "type": "number",
                  "maximum": 1.7976931348623157e+308,
                  "exclusiveMinimum": 0
                },
                "source_start": {
                  "type": "number",
                  "maximum": 1.7976931348623157e+308,
                  "minimum": 0
                },
                "source_end": {
                  "type": "number",
                  "maximum": 1.7976931348623157e+308,
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "clip",
                "export_start",
                "export_end",
                "source_start",
                "source_end"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "speaker",
          "text",
          "segments"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
