              "end": {
                "type": "number",
                "maximum": 1.7976931348623157e+308,
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "outgoing_source_window": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "maximum": 1.7976931348623157e+308,
                "minimum": 0
              },
              "end": {
                "type": "number",
                "maximum": 1.7976931348623157e+308,
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "incoming_source_window": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "maximum": 1.7976931348623157e+308,
                "minimum": 0
              },
              "end": {
                "type": "number",
                "maximum": 1.7976931348623157e+308,
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "outgoing",
          "incoming",
          "before",
          "after",
          "export_window",
          "outgoing_source_window",
          "incoming_source_window"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "approved_dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "speaker": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "start": {
            "type": "number",
            "maximum": 1.7976931348623157e+308,
            "minimum": 0
          },
          "end": {
            "type": "number",
            "maximum": 1.7976931348623157e+308,
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "speaker",
          "text",
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "dialogue_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "speaker": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clip": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "export_start": {
                  "type": "number",
                  "maximum": 1.7976931348623157e+308,
                  "minimum": 0
